# Build-time environment variables
# Copy to .env.production and fill in values before `npm run deploy`

# Public URL of the admin uploads host (used to absolutize /uploads/... paths)
ADMIN_PUBLIC_URL=http://localhost:3001

# Firebase service account JSON (one line) - used during static generation
FIREBASE_SERVICE_ACCOUNT=

# Alternative: path to a service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
